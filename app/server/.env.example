# ===========================================
# Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ===========================================
# Node Environment
# ===========================================
# Environment mode: development, production, test
NODE_ENV=development
LOG_LEVEL=info

SYNC_DB = true
# Dev/CI run over plain HTTP — `Secure` cookies would never round-trip
# (the browser/supertest agent drops them on non-HTTPS hops), so every
# post-login request would 401. Production deployments MUST override
# this to `true` via their own env.
SECURE_COOKIE = false

# ===========================================
# Server Configuration
# ===========================================
# Port number for the server (default: 3000)
PORT=8944

# Application URLs
# Frontend URL for CORS (required for authentication)
FRONTEND_URL=http://localhost:5173

# Server URL
SERVER_URL=http://localhost:8944

# Uploads directory for files (e.g. face images, bills). Default: server/uploads
# UPLOADS_DIR=/path/to/uploads

# Path to the built client bundle (must contain index.html). When SECURE_COOKIE
# is off, Express serves this bundle for any path that isn't /api/*, /iclock/*,
# /uploads/*, or /static. Default: ../client (the deploy layout, resolved
# relative to app/server). For local testing against a vite-built tree, use
# CLIENT_STATIC_DIR=../client/dist
# CLIENT_STATIC_DIR=../client

# ===========================================
# Database Configuration
# ===========================================
# Database connection URL (PostgreSQL recommended)
DATABASE_URL=postgresql://postgres:sadmin@localhost:5432/etime

# Database dialect (default: postgres)
DB_DIALECT=postgres

# ===========================================
# JWT Authentication
# ===========================================
# Secret key for JWT access tokens (REQUIRED - generate a strong secret)
JWT_SECRET=your-super-secret-jwt-access-key-here

# Secret key for JWT refresh tokens (REQUIRED - generate a strong secret)
REFRESH_TOKEN_SECRET=your-super-secret-jwt-refresh-key-here

# JWT access token expiration time (e.g., 15m, 1h, 7d)
JWT_ACCESS_EXPIRATION=15m

# JWT refresh token expiration time (e.g., 7d, 30d)
JWT_REFRESH_EXPIRATION=7d

# Maximum age for access token cookies in milliseconds (default: 15 minutes)
MAX_JWT_ACCESS_EXPIRATION_MS=900000

# ===========================================
# Report Runner (optional, socket-RPC offload)
# ===========================================
REPORT_RUNNER_URL=http://localhost:4001

# Maximum age for refresh token cookies in milliseconds (default: 7 days)
MAX_JWT_REFRESH_EXPIRATION_MS=604800000

DEFAULT_COMPANY=default

# ===========================================
# Non-interactive (CI / scripted) create_company credentials
# ===========================================
# When create_company_with_role_and_perms.js runs without a TTY (CI),
# it reads the sadmin user/password from these. Leave unset locally to
# skip user creation in non-interactive runs.
# SADMIN_USERNAME=
# SADMIN_PASSWORD=

# ===========================================
# Security & Production Settings
# ===========================================
# Set to 'true' in production for HTTPS cookies
# Set to 'false' in development for HTTP cookies
# This is automatically set based on NODE_ENV in the code

# ===========================================
# Optional: Additional Configuration
# ===========================================
# Add any additional environment variables here
# Make sure to update this file when adding new env vars

# ===========================================
# Development Notes
# ===========================================
# 1. Generate strong JWT secrets:
#    - Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#    - Or use a secure password generator
#
# 2. Database setup:
#    - Install PostgreSQL
#    - Create database: createdb startup_db
#    - Update DATABASE_URL with your credentials
#
# 3. Frontend setup:
#    - Ensure FRONTEND_URL matches your frontend development server
#    - Default is http://localhost:8944 for React/Vite
#
# 4. Security:
#    - Never commit .env files to version control
#    - Use different secrets for development and production
#    - Rotate secrets regularly in production

WALLET_SERVER_URL=http://localhost:3001/api/v1
# Postgres URL for the SSO user migrate CLI (npm run migrate:sso-users).
# If empty, the script falls back to sibling ../nbnext_wallet/server/.env.
WALLET_DATABASE_URL=

# ===========================================
# OIDC RP / Wallet SSO (ADR 001)
# ===========================================
# Wallet oidc-provider issuer (must match Wallet OIDC_ISSUER).
OIDC_ISSUER=http://localhost:3001/api/v1/oidc
# Wallet Application.app_key. One value, two uses: the OIDC client_id on the
# wire, and the key identifying this app when pushing subscriptions to Wallet.
# Must match a registered Application.app_key or both flows fail.
APP_KEY=etime-payroll
OIDC_CLIENT_SECRET=
# Must be registered on Wallet Application.redirect_uris.
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/sso/callback
OIDC_SCOPES=openid profile offline_access
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173

# ===========================================
# License (timed, signed, machine-bound)
# ===========================================

# Hourly auto-renewal against WALLET_SERVER_URL. Disable on airgapped installs.
# LICENSE_AUTO_RENEW=false
# Optional: JSON array of wallet public-key PEM strings. Overrides the
# secret/wallet_public_keys.json file. Used by orchestration systems that
# inject keys via env.
# LICENSE_WALLET_PUBLIC_KEYS='["-----BEGIN PUBLIC KEY-----\nMCowB...=\n-----END PUBLIC KEY-----\n"]'
