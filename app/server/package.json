{
  "name": "@app/server",
  "version": "1.0.3",
  "private": true,
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "build": "node ../../startup/server/scripts/build-bytecode.js --src . --out-dir ./dist",
    "create-new-company": "node ../../startup/server/create_company_with_role_and_perms.js",
    "kill": "kill -9 $(lsof -t -i:3000) 2>/dev/null || true",
    "setup-env": "node ../../startup/server/scripts/setup-env/index.js setup",
    "check-env": "node ../../startup/server/scripts/setup-env/index.js check",
    "validate-env": "node ../../startup/server/scripts/setup-env/index.js validate",
    "generate-secrets": "node ../../startup/server/scripts/setup-env/index.js generate-secrets",
    "license:install": "node ../../startup/server/scripts/license_install.js install",
    "license:machine": "node ../../startup/server/scripts/license_install.js machine",
    "license:status": "node ../../startup/server/scripts/license_install.js status",
    "license:add-public-key": "node ../../startup/server/scripts/license_install.js add-public-key"
  },
  "description": "App-side server boot. Imports buildApp() from startup/server and registers app-specific routes.",
  "_moduleAliases": {
    "@nucleus": "../../nucleus",
    "@startup": "../../startup/server",
    "@appServer": ".",
    "sequelize": "../../startup/server/node_modules/sequelize"
  },
  "dependencies": {
    "axios": "^1.3.3",
    "body-parser": "^1.20.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cron": "^4.3.3",
    "csv-parse": "^6.0.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "deep-diff": "^1.0.2",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-jwt": "^8.5.1",
    "express-validator": "^7.2.1",
    "form-data": "^4.0.4",
    "isolated-vm": "^5.0.4",
    "json2csv": "^6.0.0-alpha.2",
    "jwks-rsa": "^3.2.0",
    "module-alias": "^2.3.4",
    "multer": "^2.0.1",
    "node-cron": "^4.2.1",
    "openid-client": "^5.4.2",
    "p-map": "^7.0.3",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "bytenode": "^1.5.7",
    "jest": "^29.5.0",
    "nodemon": "^2.0.22"
  }
}
