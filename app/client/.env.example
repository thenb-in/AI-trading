# ===========================================
# Frontend Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ===========================================
# API Configuration
# ===========================================
# Backend API URL (required)
VITE_API_URL=/api/v1

# Backend base URL (required)
VITE_APP_BASENAME=/



# ===========================================
# Frontend Server Configuration
# ===========================================
# Frontend development server port (optional, default: 3000)
PORT=5173
VITE_PROXY_URL=http://localhost:8469


# ===========================================
# Development Notes
# ===========================================
# 1. Vite automatically loads .env files
# 2. All variables must be prefixed with VITE_ to be accessible in the browser
# 3. Environment variables are validated at build time
# 4. Never commit .env files to version control
# 5. Use different values for development and production


# ===========================================
# Authentication Mode
# ===========================================
# SSO (consumer) mode. When true, the app logs in/out via the external SSO
# identity provider: the entry page redirects to /api/v1/auth/sso/start and
# logout follows the server's ssoLogoutUrl. When false/unset (default), the app
# uses local username/password login and a local logout (no SSO redirect).
VITE_SSO_ENABLED=false
