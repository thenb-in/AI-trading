{
  "name": "nbnext-startup-app",
  "version": "2.0.3",
  "description": "NB Next application with client and server made with Startup App Template",
  "main": "index.js",
  "scripts": {
    "i": "npm install && cd lints && npm install && cd ../app && npm run i && cd ../tests && npm run i && cd .. && npm run setup",
    "setup": "husky && node scripts/setup-deps.js && npm run setup-hooks && npm run setup-env",
    "setup-hooks": "node scripts/setup-hooks.js",
    "setup-env": "node scripts/setup-env.js",
    "create-new-app": "node scripts/create-app.js",
    "update-starter-app": "node scripts/update-starter-app.js",
    "migrate": "node scripts/migrate.js",
    "prepare": "husky",
    "lint": "cd lints && npm run lint && cd .. && npm run check-duplicates",
    "lint:fix": "cd lints && npm run lint:fix",
    "lint:errors": "cd lints && npm run lint:errors",
    "dev": "cd app && npm run dev",
    "client": "cd app && npm run client",
    "server": "cd app && npm run server",
    "build": "cd app && npm run build",
    "start": "cd app && npm run start",
    "kill": "cd app && npm run kill",
    "report-runner": "cd report_runner && npm start",
    "report-runner:dev": "cd report_runner && npm run dev",
    "test": "cd tests && npm run test",
    "commit": "git-cz",
    "clean": "node scripts/clean.js all",
    "clean:node_modules": "node scripts/clean.js node_modules",
    "clean:build": "node scripts/clean.js build",
    "clean:logs": "node scripts/clean.js logs",
    "commitlint": "commitlint --edit",
    "commitlint:check": "commitlint --from HEAD~1 --to HEAD --verbose",
    "dev-health-check": "node scripts/dev-utils.js",
    "dev-utils:check": "node scripts/dev-utils.js check",
    "dev-utils:lint": "node scripts/dev-utils.js lint",
    "dev-utils:test": "node scripts/dev-utils.js test",
    "dev-utils:build": "node scripts/dev-utils.js build",
    "dev-utils:help": "node scripts/dev-utils.js help",
    "check-duplicates": "node scripts/check-duplicates.js",
    "create-new-company": "cd app/server && npm run create-new-company"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.34.0",
    "commitizen": "^4.3.1",
    "concurrently": "^8.2.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react": "^7.37.5",
    "git-detect-case-change": "^1.2.1",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jscpd": "^4.1.0",
    "lint-staged": "^16.1.5",
    "rimraf": "^6.0.1"
  },
  "lint-staged": {
    "{startup,app}/client/**/*.{js,jsx}": [
      "eslint --config lints/client/eslint.config.mjs --fix"
    ],
    "{startup,app}/server/**/*.js": [
      "eslint --config lints/server/eslint.config.js --fix"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "perf",
          "test",
          "build",
          "ci",
          "chore",
          "revert",
          "security",
          "deps"
        ]
      ],
      "type-case": [
        2,
        "always",
        "lower-case"
      ],
      "type-empty": [
        2,
        "never"
      ],
      "subject-empty": [
        2,
        "never"
      ],
      "subject-full-stop": [
        2,
        "never",
        "."
      ],
      "header-max-length": [
        2,
        "always",
        72
      ],
      "body-max-line-length": [
        2,
        "always",
        100
      ],
      "footer-max-line-length": [
        2,
        "always",
        100
      ]
    }
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}