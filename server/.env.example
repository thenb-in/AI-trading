NODE_ENV=development
JWT_SECRET=your_jwt_secret
PORT=5000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:admin@127.0.0.1:5432/chatbox
DB_DIALECT=postgres
REFRESH_TOKEN_SECRET=your_refresh
SERVER_URL=http://localhost:3001/

# OneSignal Push Notifications
ONESIGNAL_APP_ID=68bdb77b-7ce2-4051-89b0-418c2a97980b
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key


# JWT Configuration
JWT_ACCESS_EXPIRATION=30d                 # JWT access token expires in 30 days
JWT_REFRESH_EXPIRATION=45d                # JWT refresh token expires in 45 days

# Updated millisecond equivalents
MAX_JWT_ACCESS_EXPIRATION_MS=2592000000   # 30 days = 30 * 24 * 60 * 60 * 1000
MAX_JWT_REFRESH_EXPIRATION_MS=3888000000  # 45 days = 45 * 24 * 60 * 60 * 1000
