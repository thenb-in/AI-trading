# Report Runner — env template.
# These vars are required at boot. Copy to .env and fill in real values.

# Port + bind host. Keep on the internal network — only the app server
# should be able to reach this process.
REPORT_RUNNER_PORT=4001
REPORT_RUNNER_HOST=0.0.0.0

# Must match the app server / startup JWT_SECRET. The app server forwards
# its service token and per-RPC user context using this secret.
JWT_SECRET=

# Shared Postgres — same DB the app server uses. The models loaded from
# @appServer initialise their own sequelize pool against these creds.
DATABASE_URL=

# Optional. NODE_ENV=production silences debug logging.
NODE_ENV=development
LOG_LEVEL=info
