# Report Runner — env template.
# These vars are required at boot. Copy to .env and fill in real values.

# Port + bind host. Keep on the internal network — only the app server
# should be able to reach this process.
REPORT_RUNNER_PORT=4001
REPORT_RUNNER_HOST=0.0.0.0

# How many saved report runs may compute at once. Saved runs finish in the
# background, so they queue rather than all fighting for the same CPU; the
# synchronous path (dashboard tiles) is not affected. Default 2.
REPORT_RUNNER_CONCURRENCY=2

# Must match the app server / startup JWT_SECRET. The app server forwards
# its service token and per-RPC user context using this secret.
JWT_SECRET=

# Shared Postgres — same DB the app server uses. The models loaded from
# @appServer initialise their own sequelize pool against these creds.
DATABASE_URL=

# MUST be the same absolute path the app server uses. This process writes report
# payloads under <UPLOADS_DIR>/report_runs/ and the app server serves them from
# there, so a mismatch means every finished report 404s on download while the
# files sit in a directory nobody reads. Left unset it falls back to <repo>/uploads,
# which is only correct if the app server is also unset.
UPLOADS_DIR=

# Optional. NODE_ENV=production silences debug logging.
NODE_ENV=development
LOG_LEVEL=info
