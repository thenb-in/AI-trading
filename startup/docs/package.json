{
  "name": "@startup/docs",
  "version": "1.0.0",
  "private": true,
  "description": "Common docs engine (Docusaurus). The generic manual lives in startup/docs/content; an app overlays its own pages from app/docs/content, and the two are merged into one site.",
  "scripts": {
    "start": "docusaurus start --port 5171",
    "build": "docusaurus build",
    "serve": "docusaurus serve --port 5171",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "^3.6.3",
    "@docusaurus/preset-classic": "^3.6.3",
    "@easyops-cn/docusaurus-search-local": "^0.45.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "browserslist": {
    "production": [">0.5%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  },
  "engines": {
    "node": ">=18.0"
  }
}
