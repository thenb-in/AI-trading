{
  "name": "integration-tests",
  "version": "1.0.0",
  "description": "Integration tests for API endpoints using Vitest + Supertest",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:report": "npx vite preview --outDir test-results --host",
    "test:dev": "vitest --ui"
  },
  "keywords": [
    "integration",
    "testing",
    "api",
    "vitest",
    "supertest"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "@vitest/ui": "^2.1.9",
    "supertest": "^7.2.2",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "papaparse": "^5.5.3",
    "xlsx": "^0.18.5"
  }
}
