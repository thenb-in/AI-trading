# API Configuration
API_BASE_URL=http://localhost:6384

# Optional: frontend base URL for report links in test failure messages (defaults to API_BASE_URL)
# FRONTEND_BASE_URL=http://localhost:5173

# Test admin credentials (REQUIRED). Use a regular admin-role user here, not
# the sadmin (super-admin) — the e2e suite covers the sadmin flow separately.
TEST_ADMIN_USERNAME=admin1
TEST_ADMIN_PASSWORD=123456

# Optional: company name to switch to for workflow tests (must match exactly, case-insensitive)
# If set, tests switch to this company; otherwise the first allowed company is used.
# TEST_COMPANY_NAME=theNB Digital Solutions

# Optional: set to true to run teardown (delete timetable, deactivate employee). Otherwise those steps are skipped.
# CLEANUP_TEST_DATA=true
TEST_COMPANY_NAME=theNB Digital Solutions
CLEANUP_TEST_DATA=false
