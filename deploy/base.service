[Unit]
Description=nbnext_app_name App
After=network.target

[Service]
Environment=PATH=nvm_path/bin:/usr/bin:/bin
WorkingDirectory=server_path/server
ExecStart=npm_path start
Restart=always
RestartSec=5
User=system_user
Environment=NODE_ENV=production
SyslogIdentifier=nbnext_app_name

[Install]
WantedBy=multi-user.target