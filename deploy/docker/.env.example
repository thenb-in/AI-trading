# Docker install config — copy to `.env` next to docker-compose.yml and edit.
# On Windows, install.ps1 writes this for you. This file feeds docker-compose.yml
# only; the server's own configuration lives in docker_data/config/.env, seeded
# on first boot.

# Names the stack, its database volume (<name>_db-data) and, on Windows, the
# scheduled tasks and backup files. Set it to the app you are deploying.
COMPOSE_PROJECT_NAME=myapp

# HTTP port published on the host (what staff browse to).
APP_PORT=80
# Full URL staff reach the app at — host/IP + the port above (omit :80).
APP_URL=http://localhost
# Host/IP staff browse to (informational; used to build APP_URL on Windows).
SERVER_HOST=localhost


# Postgres — the DB lives only in the db-data volume, so pick a password once.
# Name the database after the app you are deploying.
DB_NAME=startup_db
DB_PASSWORD=change-me

# IANA time zone — timestamps are stamped in it.
TZ=Asia/Kolkata

# REQUIRED for `docker compose up --build`: the Node the image is built on. Set
# it to the bundle's VERSION node_version (strip the leading v). On Windows,
# install.ps1 fills this in for you.
NODE_VERSION=

# Optional: tag for the locally-built image. Each app built from this template
# sets its own; docker-compose.yml carries the fallback.
# APP_IMAGE=myapp/server:local
