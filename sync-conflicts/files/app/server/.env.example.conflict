# ===========================================
# Hourly auto-renewal against WALLET_SERVER_URL. Disable on airgapped installs.
# LICENSE_AUTO_RENEW=false
# Optional: JSON array of wallet public-key PEM strings. Overrides the
# secret/wallet_public_keys.json file. Used by orchestration systems that
# inject keys via env.
# LICENSE_WALLET_PUBLIC_KEYS='["-----BEGIN PUBLIC KEY-----\nMCowB...=\n-----END PUBLIC KEY-----\n"]'
# Docker installs only. A container sees a synthetic MAC and a per-image
# machine-id, so the installer stamps the HOST's identity into this JSON file
# and the license stays bound to the physical box. Set by
# deploy/docker/docker-compose.yml; leave unset on bare-metal installs.
# HOST_MACHINE_FILE=/srv/config/host_machine.json


