# ===========================================
# OIDC RP / Wallet SSO (ADR 001)
# ===========================================
# Wallet oidc-provider issuer (must match Wallet OIDC_ISSUER). Same wallet host
# as WALLET_SERVER_URL above; for development against a local wallet, point both
# back at http://localhost:3001/api/v1.
OIDC_ISSUER=https://wallet.nbnext.in/api/v1/oidc
# Wallet Application.app_key. One value, two uses: the OIDC client_id on the
# wire, and the key identifying this app when pushing subscriptions to Wallet.
# Must match a registered Application.app_key or both flows fail — each app
# built from this template registers and sets its own.
APP_KEY=
OIDC_CLIENT_SECRET=
# Must be registered on Wallet Application.redirect_uris, and must agree with
# the SERVER_URL above.
OIDC_REDIRECT_URI=http://localhost:8332/api/v1/auth/sso/callback
OIDC_SCOPES=openid profile offline_access
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173


