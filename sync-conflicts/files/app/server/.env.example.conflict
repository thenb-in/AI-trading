# ===========================================
# Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env
#
# dotenv-safe treats every uncommented key here as required, so each must also
# be present in .env — empty is fine (allowEmptyValues is on). Deleting a key
# from .env while it is listed here stops the server booting.

# ===========================================
# Node Environment
# ===========================================
# Environment mode: development, production, test
NODE_ENV=development
LOG_LEVEL=info

# `true` here, not because cookies need HTTPS to round-trip — `http://localhost`
# is itself a browser-secure context, so a `Secure` cookie works fine over plain
# HTTP as long as the origin is loopback (see .github/workflows/linux_built_tests.yml,
# which overrides this to `false` for its own non-loopback plain-HTTP host) —
# but because the license gate reads this flag the other way round: `false`
# means "self-hosted install, enforce the license," which locks every route but
# /auth/login and /license/* behind a 503 the moment the server boots (see
# src/license/engine/operations/verify.js). `true` is what keeps local dev and
# CI running without a signed license token; a real on-prem deployment sets
# `false` explicitly in its own `.env`, not here.
SECURE_COOKIE = true


# ===========================================
# Server Configuration
# ===========================================
# Port number for the server
PORT=8332

# Frontend URL for CORS (required for authentication)
FRONTEND_URL=http://localhost:5173

# Server URL
SERVER_URL=http://localhost:8332

# Uploads directory for files. Default: server/uploads
# UPLOADS_DIR=/path/to/uploads

# Path to the built client bundle (must contain index.html). When SECURE_COOKIE
# is off, Express serves this bundle for any path that isn't /api/*, /uploads/*,
# or /static. Default: ../client (the deploy layout, resolved relative to
# app/server). For local testing against a vite-built tree, use
# CLIENT_STATIC_DIR=../client/dist
# CLIENT_STATIC_DIR=../client

# Report runner — optional Socket.IO offload for heavy GET reports.
# When set, the app server connects outbound to this URL; run report_runner
# separately. Leave unset to run reports in-process (single-process deployment).
REPORT_RUNNER_URL=http://localhost:8333


# ===========================================
# Database Configuration
# ===========================================
# PostgreSQL connection URL. Create the database first (see notes at the
# bottom), then point this at it with your own credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/startup_db


# ===========================================
# JWT Authentication
# ===========================================
# Secret key for JWT access tokens (REQUIRED - generate a strong secret)
JWT_SECRET=your-super-secret-jwt-access-key-here

# Secret key for JWT refresh tokens (REQUIRED - generate a strong secret)
REFRESH_TOKEN_SECRET=your-super-secret-jwt-refresh-key-here

# JWT access token expiration time (e.g., 15m, 1h, 7d)
JWT_ACCESS_EXPIRATION=15m

# JWT refresh token expiration time (e.g., 7d, 30d)
JWT_REFRESH_EXPIRATION=7d

# Maximum age for access token cookies in milliseconds (default: 15 minutes)
MAX_JWT_ACCESS_EXPIRATION_MS=900000

# Maximum age for refresh token cookies in milliseconds (default: 7 days)
MAX_JWT_REFRESH_EXPIRATION_MS=604800000


