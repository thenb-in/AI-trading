# Security & Production Settings
# ===========================================
# Secure (HTTPS-only) cookies. Left unset, it follows NODE_ENV: true in production, false otherwise.
# It also switches licence enforcement: true is the hosted install, which bypasses the licence;
# false is self-hosted/on-prem, which locks the server (503) until LICENSE_WALLET_PUBLIC_KEYS
# or a licence is supplied. Local development therefore runs with true.
SECURE_COOKIE=true


