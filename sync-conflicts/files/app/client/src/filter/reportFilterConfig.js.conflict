// The Calling → Conversion dashboard uses the SAME filter bar as the reports, but
// a dashboard opens on a span, not a single day — so its date range defaults to the
// past 7 days including today, and it keeps the User picker from the call-buddy
// reports. Everything else (quick-date presets, Apply/Reset) comes for free.
const DASHBOARD_START = getLocalDateStringYmd(shiftDays(new Date(), -6));
const dashboardDateFilters = [
  { name: 'start_date', label: 'Start Date', type: 'date', default: DASHBOARD_START, is_standard: true, order: 1 },
  { name: 'end_date', label: 'End Date', type: 'date', default: TODAY, is_standard: true, order: 2 },
];
// Just the User picker from the user-based bundle — the Is Active toggle it also
// carries has no effect on the lead/call data the dashboard reads, so it is dropped.
