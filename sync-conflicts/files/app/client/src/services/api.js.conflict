  updateCompanyProfile: (payload) => ApiService.request('PUT', '/company-profile', payload, { invalidates: ['companyProfile'] }),
  sendWelcomeEmailsToCustomers: () => ApiService.request('POST', '/company-profile/send-welcome-emails')
