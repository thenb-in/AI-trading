# ===========================================
# SafeChat Frontend Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ===========================================
# API Configuration
# ===========================================
# Backend API URL (required)
VITE_API_URL=http://localhost:5000/api/v1

# Backend base URL (required)
VITE_BACKEND_BASE_URL=http://localhost:5000

# ===========================================
# Server Configuration
# ===========================================
# Frontend development server port (optional, default: 3000)
PORT=3000

# ===========================================
# OneSignal Configuration
# ===========================================
# OneSignal App ID for push notifications (required)
VITE_ONESIGNAL_APP_ID=your-onesignal-app-id-here

# ===========================================
# Development Notes
# ===========================================
# 1. Vite automatically loads .env files
# 2. All variables must be prefixed with VITE_ to be accessible in the browser
# 3. Environment variables are validated at build time
# 4. Never commit .env files to version control
# 5. Use different values for development and production
